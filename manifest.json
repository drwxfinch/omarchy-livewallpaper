{
  "schemaVersion": 1,
  "id": "morph.livewall",
  "name": "Livewall",
  "version": "1.1.1",
  "author": "morph",
  "description": "Live video wallpapers on the Hyprland background layer, per monitor, with previews and automatic pause.",
  "kinds": [
    "bar-widget",
    "service"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "service": "Service.qml"
  },
  "barWidget": {
    "displayName": "Livewall",
    "description": "Live video wallpapers with a per-monitor preview grid, sync switch, and automatic pause.",
    "category": "Appearance",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "folder": "~/Videos",
      "video": "",
      "mode": "live",
      "paused": false,
      "syncMonitors": true,
      "monitors": {},
      "autoWindows": true,
      "autoBattery": true,
      "autoLock": true,
      "bind": ""
    },
    "schema": [
      {
        "key": "folder",
        "type": "string",
        "label": "Video folder"
      },
      {
        "key": "video",
        "type": "string",
        "label": "Default video (all monitors when sync is on)"
      },
      {
        "key": "mode",
        "type": "string",
        "label": "Default mode: live or static"
      },
      {
        "key": "paused",
        "type": "boolean",
        "label": "Default manual pause"
      },
      {
        "key": "syncMonitors",
        "type": "boolean",
        "label": "Use the same wallpaper on all monitors"
      },
      {
        "key": "monitors",
        "type": "object",
        "label": "Per-monitor settings keyed by output name"
      },
      {
        "key": "autoWindows",
        "type": "boolean",
        "label": "Pause when a window covers the workspace"
      },
      {
        "key": "autoBattery",
        "type": "boolean",
        "label": "Pause on battery"
      },
      {
        "key": "autoLock",
        "type": "boolean",
        "label": "Pause while locked"
      },
      {
        "key": "bind",
        "type": "string",
        "label": "Panel keybinding"
      }
    ]
  }
}
